# Copia este archivo a .env y cambia los valores. .env NUNCA se sube al repositorio.

# Clave secreta de Django: genera una con
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia-esto

# Dominio(s) por los que se entra a la app, separados por coma.
DJANGO_ALLOWED_HOSTS=pos.mi-ferreteria.com
# Origen completo (con https://) si se entra por un dominio con HTTPS.
CSRF_TRUSTED_ORIGINS=https://pos.mi-ferreteria.com

# HTTPS: el modo sin conexión (service worker) y las cookies seguras lo necesitan.
# Pon 1 si un proxy (Caddy, nginx, Cloudflare) termina HTTPS delante de la app.
DJANGO_BEHIND_HTTPS_PROXY=1
# Solo para probar sin HTTPS (por ejemplo en localhost): 0. En producción, 1.
DJANGO_SECURE_COOKIES=1

# PostgreSQL
DB_NAME=inventario
DB_USER=inventario
DB_PASSWORD=cambia-esto-tambien

# Opcionales
# APP_PORT=8000
# GUNICORN_WORKERS=3
# SESSION_COOKIE_AGE=43200
